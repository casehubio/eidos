<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.casehub</groupId>
    <artifactId>casehub-parent</artifactId>
    <version>0.4-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <groupId>io.casehub</groupId>
  <artifactId>casehub-eidos-parent</artifactId>
  <version>0.4-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CaseHub Eidos - Parent</name>
  <description>Agent identity — structured descriptor, discovery registry, vocabulary system, and system prompt generation for Quarkus applications</description>
  <url>https://github.com/casehubio/eidos</url>

  <modules>
    <module>api</module>
    <module>eidos-core</module>
    <module>annotations</module>
    <module>runtime</module>
    <module>persistence-memory</module>
    <module>deployment</module>
    <module>vocab</module>
    <module>examples</module>
    <module>eval</module>
    <module>graphql</module>
    <module>graph</module>
    <module>org-api</module>
    <module>org-memory</module>
    <module>org-runtime</module>
    <module>org-annotations</module>
  </modules>


  <repositories>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/*</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/eidos</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/eidos</url>
      <uniqueVersion>false</uniqueVersion>
    </snapshotRepository>
  </distributionManagement>

  <scm>
    <connection>scm:git:https://github.com/casehubio/eidos.git</connection>
    <developerConnection>scm:git:https://github.com/casehubio/eidos.git</developerConnection>
    <url>https://github.com/casehubio/eidos</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- Aliases for child module references — values come from casehub-parent -->
    <quarkus.version>${quarkus.platform.version}</quarkus.version>
    <casehub-platform-api.version>${casehub.version}</casehub-platform-api.version>
    <casehub-ledger-api.version>${casehub.version}</casehub-ledger-api.version>
    <casehub-ledger.version>${casehub.version}</casehub-ledger.version>
    <casehub-platform-yaml-core.version>${casehub.version}</casehub-platform-yaml-core.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.casehub</groupId>
        <artifactId>casehub-eidos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
